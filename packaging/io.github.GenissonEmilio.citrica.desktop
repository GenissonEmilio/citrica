[Desktop Entry]
Type=Application
Name=Cítrica
Comment=Roda de conversão local no desktop Linux
Exec=/opt/citrica/citrica --setup %F
Icon=io.github.GenissonEmilio.citrica
Terminal=false
Categories=Utility;Graphics;AudioVideo;
Keywords=convert;converter;pdf;image;offline;
MimeType=image/png;image/jpeg;image/webp;image/avif;application/pdf;video/mp4;audio/mpeg;
Actions=Dock;

[Desktop Action Dock]
Name=Mostrar roda
Exec=/opt/citrica/citrica --dock
